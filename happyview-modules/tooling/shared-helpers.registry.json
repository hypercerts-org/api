{
  "families": [
    {
      "id": "did-validation",
      "description": "DID syntax check",
      "lookalikes": ["^valid_[a-z_]*did"],
      "inline": [
        {
          "id": "did-pattern",
          "pattern": "\\^did:",
          "description": "the DID syntax pattern"
        }
      ],
      "homes": ["lua/shared/didValidation.lua"]
    },
    {
      "id": "nsid-validation",
      "description": "NSID syntax check",
      "lookalikes": ["^valid_[a-z_]*nsid"],
      "homes": ["lua/shared/nsidValidation.lua"]
    },
    {
      "id": "record-identifier",
      "description": "AT-URI record key and record URI parsing",
      "lookalikes": ["valid_record_(uri|key)"],
      "inline": [
        {
          "id": "at-uri-pattern",
          "pattern": "\\^at://",
          "description": "the AT-URI parsing pattern"
        }
      ],
      "homes": ["lua/shared/recordIdentifier.lua"]
    },
    {
      "id": "datetime-validation",
      "description": "RFC 3339 datetime check",
      "lookalikes": ["^valid_[a-z_]*(datetime|timestamp)"],
      "homes": ["lua/shared/datetimeValidation.lua"]
    },
    {
      "id": "handle-resolver",
      "description": "handle syntax check and handle resolution",
      "lookalikes": ["^valid_(handle|ipv4|ipv6|port)", "resolve_handle"],
      "homes": ["lua/shared/identityResolver.lua", "lua/shared/profileLookup.lua"]
    },
    {
      "id": "list-cursor",
      "description": "list cursor encoding and decoding",
      "lookalikes": ["cursor_(decode|encode)", "(decode|encode)_([a-z_]+_)?cursor"],
      "inline": [
        {
          "id": "cursor-hex-decode",
          "pattern": "tonumber\\(pair, 16\\)",
          "description": "hex cursor decoding"
        },
        {
          "id": "cursor-length-cap",
          "pattern": "#token > 8192",
          "description": "the cursor length cap"
        }
      ],
      "homes": ["lua/shared/listCursor.lua", "lua/shared/listQuery.lua"]
    },
    {
      "id": "list-params",
      "description": "limit, includeTotal and sortDirection parsing",
      "lookalikes": ["^parse_[a-z_]*(limit|include_total|sort_direction)"],
      "inline": [
        {
          "id": "limit-message",
          "pattern": "limit must be an integer",
          "description": "limit parsing"
        },
        {
          "id": "include-total-message",
          "pattern": "includeTotal must be true or false",
          "description": "includeTotal parsing"
        },
        {
          "id": "sort-direction-message",
          "pattern": "sortDirection must be",
          "description": "sortDirection parsing"
        }
      ],
      "homes": [
        "lua/shared/listValidation.lua",
        "lua/shared/includeTotal.lua",
        "lua/shared/listQuery.lua"
      ]
    },
    {
      "id": "query-params",
      "description": "InvalidRequest errors, unknown-parameter checks and single-value parameters",
      "lookalikes": ["(^|_)(invalid|keys_only|scalar)$"],
      "inline": [
        {
          "id": "occur-once-message",
          "pattern": "must occur once",
          "description": "single-value parameter parsing"
        }
      ],
      "homes": ["lua/shared/query.lua"]
    },
    {
      "id": "repeated-query-array",
      "description": "repeated query parameter (array) parsing",
      "lookalikes": ["(^|_)array(_values)?$"],
      "homes": ["lua/shared/queryArray.lua"]
    },
    {
      "id": "record-view",
      "description": "the {uri, cid, indexedAt, did, record} view of an indexed row",
      "lookalikes": ["record_view"],
      "inline": [
        {
          "id": "indexed-at-null",
          "pattern": "indexed_at == nil and NULL",
          "description": "the indexedAt null fallback"
        }
      ],
      "homes": ["lua/shared/recordView.lua"]
    },
    {
      "id": "actor-view",
      "description": "actor profile/organization hydration",
      "lookalikes": ["^[a-z_]*hydrate_[a-z_]*actor_views$"],
      "homes": ["lua/shared/actorView.lua"]
    },
    {
      "id": "batch-request-target",
      "description": "batch GET request-target size limit",
      "lookalikes": ["^[a-z_]*request_target[a-z_]*$"],
      "homes": ["lua/shared/batchRequestTarget.lua"]
    }
  ],
